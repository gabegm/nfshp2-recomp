+bool render_profile_requested() {
+    const char *value = std::getenv("PS2_PROFILE_RENDER");
+    return value && std::strcmp(value, "1") == 0;
+}
+
+void prepare_render_profile(bool threaded) {
+    if (!std::getenv("PS2_PROFILE") || !render_profile_requested()) return;
+    g_render_requested = 1;
+    if (!threaded) {
+        std::fprintf(stderr, "[profile] render CPU profiling requires a threaded window run\n");
+        return;
+    }
+    g_render_tid = static_cast<pid_t>(syscall(SYS_gettid));
+    g_render_ready = pthread_getcpuclockid(pthread_self(), &g_render_clock) == 0;
+    if (!g_render_ready) std::fprintf(stderr, "[profile] cannot obtain the rendering thread's CPU clock\n");
+}
+
+void finish_render_profile() {
+    if (!g_render_requested) return;
+    // This runs on the sampled thread after the emulation worker has joined.
+    // Block any pending notification before reading the hit counters.
+    sigset_t mask;
+    sigemptyset(&mask);
+    sigaddset(&mask, SIGPROF);
+    pthread_sigmask(SIG_BLOCK, &mask, nullptr);
+    if (const char *path = std::getenv("PS2_PROFILE")) write_profile(path);
+}
+
