+// PSMT4 uses 128x128 pages with table entries measured in nibbles.
+fn tap4(s: Setup, page: u32, n: u32, k: u32) -> u32 {
+    let a = page + (n >> 1u);
+    let raw = load_texel(Loc((a & 0x3FFFFFu) >> 2u, (a & 3u) * 8u + (n & 1u) * 4u, 0xFu), k);
+    let e = clut[s.clut * CLUT_ENTRIES + (s.csa & 15u) * 16u + raw];
+    if (s.cpsm == PSMCT32 || s.cpsm == PSMCT24) { return e; }
+    return expand16(e, s);
+}
