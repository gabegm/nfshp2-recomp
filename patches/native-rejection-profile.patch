+    if (!triangle) mask|=1u<<0;
+    if (s[3]!=0 || s[4]!=0) mask|=1u<<1;
+    if (s[6]!=0x31 || s[23]!=0xffffff) mask|=1u<<2;
+    const auto alpha=(s[7]>>12)&255;
+    if ((s[0]&8u) && ((alpha&3)!=((alpha>>2)&3) || ((alpha>>6)&3)!=0)) mask|=1u<<3;
+    if (!(s[0]&2048u) || (s[0]&(4u|128u|4096u)) || ((s[7]>>28)&3)) mask|=1u<<4;
+    if ((s[0]&64u) && ((s[7]>>4)&3)) mask|=1u<<5;
+    bool texture_format=true;
+    switch(s[14]) {case 0:case 1:case 2:case 10:case 0x13:case 0x14:case 0x1b:case 0x24:case 0x2c:case 0x30:case 0x31:case 0x32:case 0x3a:break;default:texture_format=false;}
+    if (!(s[0]&2u) || ((s[7]>>24)&3)>1 || ((s[7]>>26)&3)>1 || (s[15]&255)>10 || (s[15]>>8)>10 || !texture_format) mask|=1u<<6;
+    const auto width=std::uint64_t(s[2])*64,height=std::uint64_t(s[11]>>16)+1;
+    const bool dimensions=width && width<=2048 && height<=2048 && width*height<=(1u<<20);
+    if (!dimensions || (s[10]&65535) || (s[11]&65535) || (s[10]>>16)!=width-1) mask|=1u<<7;
+    if (dimensions) {
+        const auto interval=[&](unsigned i,std::uint64_t w,std::uint64_t h,std::uint64_t &lo,std::uint64_t &hi) {
+            const auto px=s[i+3]&15,py=(s[i+3]>>4)&15;
+            if(!px || px>7 || !py || py>7)return false;
+            lo=s[i];hi=lo+(((w-1)>>px)+((h-1)>>py)*s[i+1]+1)*8192;
+            return hi<=(4u<<20);
