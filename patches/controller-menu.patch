diff --git a/host/window.cpp b/host/window.cpp
--- a/host/window.cpp
+++ b/host/window.cpp
@@ -151,3 +151,5 @@
 Uint32 g_menu_opened_ticks = 0;
 bool g_block_input[2] = {};
+Uint32 g_start_hold_since[2] = {};
+bool g_start_hold_used[2] = {};
 int g_stick_step[2] = {};  // the left stick moving the highlight: -1 up, 1 down, 0 near the middle
@@ -1357,3 +1359,23 @@ void poll() {
     }
     window_stage("reading the controllers");
+    // A long press of Start opens the quick menu with one controller button.
+    // A short press still reaches the game normally (for its pause menu).
+    if (!g_menu.is_open()) {
+        const Uint32 now = SDL_GetTicks();
+        for (int port = 0; port < 2; ++port) {
+            SDL_GameController *pad = g_pads[port];
+            if (!pad || !SDL_GameControllerGetButton(pad, SDL_CONTROLLER_BUTTON_START)) {
+                g_start_hold_since[port] = 0;
+                g_start_hold_used[port] = false;
+                continue;
+            }
+            if (g_start_hold_used[port] || SDL_GameControllerGetButton(pad, SDL_CONTROLLER_BUTTON_BACK)) continue;
+            if (!g_start_hold_since[port]) g_start_hold_since[port] = now ? now : 1;
+            else if (now - g_start_hold_since[port] >= 1000) {
+                g_start_hold_used[port] = true;
+                open_menu("Start held for one second");
+                break;
+            }
+        }
+    }
     const auto after_events = ps2::hitch::on() ? ps2::hitch::Clock::now() : ps2::hitch::Clock::time_point{};
