+struct CensusStats { std::uint32_t entry = 0; std::uint64_t calls = 0, kicks = 0, qwords = 0; };
+struct CensusConfig {
+    std::FILE *out = nullptr;
+    std::filesystem::path root;
+    std::uint64_t from = 0, frames = 1, calls = 0;
+    unsigned samples = 1, total_samples = 0;
+    std::uint64_t active_frame = ~0ull;
