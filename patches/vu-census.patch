+        g_census_call = this;
+        id = ++config->calls;
+        pc &= 16383u;
+        const auto slot = pc >> 3;
+        if (config->generations[slot] != g_generation[1]) {
+            config->keys[slot] = program_key(g_vu1_code, reachable(g_vu1_code, 16383u, pc), pc);
+            config->generations[slot] = g_generation[1];
+        }
+        const auto key = config->keys[slot];
+        stats = &config->stats[key];
+        stats->entry = pc;
+        ++stats->calls;
+        if (config->total_samples < 128 && config->captured[key]++ < config->samples) {
+            ++config->total_samples;
+            char name[80];
+            std::snprintf(name, sizeof name, "%016llX_%04X_%llu", static_cast<unsigned long long>(key), pc, static_cast<unsigned long long>(id));
+            sample = name;
+            config->bytes(sample + "-code.bin", g_vu1_code, 16384);
+            config->bytes(sample + "-before.bin", g_vu1_mem, 16384);
+            config->registers(sample + "-regs-before.bin");
+        }
+        if (!sample.empty()) std::fprintf(config->out, "{\"type\":\"call\",\"id\":%llu,\"frame\":%llu,\"key\":\"%016llX\",\"entry\":%u,\"top\":%u,\"itop\":%u,\"sample\":\"%s\"}\n", static_cast<unsigned long long>(id), static_cast<unsigned long long>(frame), static_cast<unsigned long long>(key), pc, g_top, g_itop, sample.c_str());
+        std::fflush(config->out);
+    }
+    ~CensusCall() {
+        if (!config) return;
+        if (!sample.empty()) {
+            config->bytes(sample + "-after.bin", g_vu1_mem, 16384);
+            config->registers(sample + "-regs-after.bin");
+        }
+        if (!sample.empty()) std::fprintf(config->out, "{\"type\":\"end\",\"id\":%llu,\"kicks\":%u}\n", static_cast<unsigned long long>(id), kicks);
+        std::fflush(config->out);
+        g_census_call = previous;
+    }
+};
+void census_packet(const std::uint8_t *data, std::uint32_t qwords, std::uint32_t address) {
+    if (!g_census_call) return;
+    auto &call = *g_census_call;
+    std::string packet;
+    ++call.stats->kicks;
+    call.stats->qwords += qwords;
+    if (!call.sample.empty() && call.kicks < 32) packet = call.sample + "-kick" + std::to_string(call.kicks) + ".gif";
+    if (!packet.empty()) call.config->bytes(packet, data, static_cast<std::size_t>(qwords) * 16);
+    if (!call.sample.empty()) std::fprintf(call.config->out, "{\"type\":\"kick\",\"id\":%llu,\"index\":%u,\"address\":%u,\"qwords\":%u,\"packet\":\"%s\"}\n", static_cast<unsigned long long>(call.id), call.kicks, address, qwords, packet.c_str());
+    ++call.kicks;
+    std::fflush(call.config->out);
+}
