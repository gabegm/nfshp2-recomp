+    CensusConfig() {
+        const auto folder = os::env("PS2_VU_CENSUS_DIR");
+        if (folder.empty()) return;
+        root = os::path(folder);
+        std::error_code error;
+        std::filesystem::create_directories(root, error);
+        if (error) { std::fprintf(stderr, "[vu-census] cannot create capture directory\n"); return; }
+        out = os::open((root / "calls.jsonl").string().c_str(), "w");
+        if (!out) { std::fprintf(stderr, "[vu-census] cannot open capture log\n"); return; }
