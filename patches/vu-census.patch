+        if (const auto n = os::env("PS2_VU_CENSUS_FRAMES"); !n.empty()) frames = std::clamp<std::uint64_t>(std::strtoull(n.c_str(), nullptr, 10), 1, 600);
+        if (const auto n = os::env("PS2_VU_CENSUS_SAMPLES"); !n.empty()) samples = std::clamp<unsigned>(std::strtoul(n.c_str(), nullptr, 10), 0, 8);
+        std::fprintf(out, "{\"type\":\"header\",\"version\":1,\"clock\":\"emulation-frame-at-vu-call\"}\n");
+        std::fflush(out);
+    }
+    void next_frame(std::uint64_t frame) {
+        if (active_frame == frame) return;
+        for (const auto &[key, count] : stats)
+            std::fprintf(out, "{\"type\":\"summary\",\"frame\":%llu,\"key\":\"%016llX\",\"entry\":%u,\"calls\":%llu,\"kicks\":%llu,\"qwords\":%llu}\n", static_cast<unsigned long long>(active_frame), static_cast<unsigned long long>(key), count.entry, static_cast<unsigned long long>(count.calls), static_cast<unsigned long long>(count.kicks), static_cast<unsigned long long>(count.qwords));
+        stats.clear();
+        active_frame = frame;
+        std::fflush(out);
+    }
+    void bytes(const std::string &name, const void *data, std::size_t size) {
+        std::ofstream file(root / name, std::ios::binary);
+        if (!file.write(static_cast<const char *>(data), size)) std::fprintf(stderr, "[vu-census] capture write failed\n");
+    }
+    void registers(const std::string &name) {
+        // Explicit little-endian words, independent of C++ structure padding.
+        std::vector<std::uint8_t> bytes;
+        const auto word = [&](std::uint32_t w) { for (unsigned i = 0; i < 4; ++i) bytes.push_back(static_cast<std::uint8_t>(w >> (i * 8))); };
+        for (const auto &v : g_vu1.vf) for (auto w : v.w) word(w);
+        for (auto w : g_vu1.acc.w) word(w);
+        for (auto w : g_vu1.vi) word(w);
+        for (auto w : {g_vu1.q, g_vu1.p, g_vu1.i, g_vu1.r, g_vu1.mac, g_vu1.status, g_vu1.clip, g_vu1.cmsar0, g_vu1.tpc}) word(w);
+        this->bytes(name, bytes.data(), bytes.size());
+    }
+};
+struct CensusCall {
+    CensusConfig *config = nullptr;
+    CensusCall *previous = nullptr;
+    CensusStats *stats = nullptr;
+    std::uint64_t id = 0;
+    std::uint32_t kicks = 0;
+    std::string sample;
+    CensusCall(int unit, std::uint32_t pc) {
+        if (unit != 1 || g_reference_dry) return;
+        static CensusConfig census;
+        if (!census.out) return;
+        const auto frame = frame_count();
+        census.next_frame(frame);
