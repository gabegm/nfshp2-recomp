diff --git a/runtime/src/iop/sif.cpp b/runtime/src/iop/sif.cpp
index d071590..767a95e 100644
--- a/runtime/src/iop/sif.cpp
+++ b/runtime/src/iop/sif.cpp
@@ -91,5 +91,8 @@ template <typename T>
 T ee_read(std::uint32_t a) {
     T v;
-    std::memcpy(&v, g_ram + (a & (kRamSize - 1)), sizeof v);
+    const auto *source = (a >> 14) == (kScratchpadBase >> 14)
