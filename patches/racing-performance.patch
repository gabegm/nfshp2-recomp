+// Indexed 8-bit textures use 128x64 pages. Share page-coordinate arithmetic
+// across the four bilinear taps instead of decoding a generic format each time.
+fn tap8(s: Setup, page: u32, n: u32, k: u32) -> u32 {
+    let a = page + n;
+    let raw = load_texel(Loc((a & 0x3FFFFFu) >> 2u, (a & 3u) * 8u, 0xFFu), k);
+    let e = clut[s.clut * CLUT_ENTRIES + raw];
+    if (s.cpsm == PSMCT32 || s.cpsm == PSMCT24) { return e; }
+    return expand16(e, s);
+}
