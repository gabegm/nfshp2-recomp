# Only publish the hand-written setup. All game-derived content stays local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/OPTIMIZATION.md
!/LICENSE
!/scripts/
/scripts/*
!/scripts/build.sh
!/scripts/check-public-files.py
!/scripts/play.sh
!/scripts/fetch-widescreen.py
!/tests/
/tests/*
!/tests/test_widescreen.py
!/patches/
/patches/*
!/patches/runtime-compatibility.patch
!/patches/presentation-performance.patch
!/patches/LICENSE.upstream

# Never track disc images, including mixed-case extensions, in any directory.
*.[iI][sS][oO]
